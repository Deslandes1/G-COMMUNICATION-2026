{
  "rules": {
    ".read": "auth != null",
    ".write": "auth != null",
    "users": {
      "$uid": {
        ".read": "auth != null",
        ".write": "auth != null && auth.uid === $uid"
      }
    },
    "statuses": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "wall_posts": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "friend_requests": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "public_users": {
      ".read": "auth != null",
      ".write": "auth != null"
    },
    "presence": {
      ".read": "auth != null",
      "$uid": {
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
      
